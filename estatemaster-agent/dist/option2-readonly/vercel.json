{
  "cleanUrls": true,
  "functions": {
    "api/llm.js": {
      "maxDuration": 800
    },
    "api/scan.js": {
      "maxDuration": 800
    },
    "api/voice.js": {
      "maxDuration": 30
    },
    "api/mail.js": {
      "maxDuration": 30
    },
    "api/cron.js": {
      "maxDuration": 800
    },
    "api/schedule.js": {
      "maxDuration": 800
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/demo.webm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?run=tick",
      "schedule": "*/15 * * * *"
    }
  ]
}
