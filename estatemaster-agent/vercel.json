{
  "cleanUrls": true,
  "functions": {
    "api/llm.js": {
      "maxDuration": 800
    },
    "api/scan.js": {
      "maxDuration": 800
    },
    "api/runner.js": {
      "maxDuration": 30
    },
    "api/voice.js": {
      "maxDuration": 30
    },
    "api/mail.js": {
      "maxDuration": 30
    },
    "api/cron.js": {
      "maxDuration": 800
    },
    "api/schedule.js": {
      "maxDuration": 800
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?run=tick",
      "schedule": "*/15 * * * *"
    }
  ]
}
