# ─────────────────────────────────────────────────────────────────────────────
# Kinan Onsite Agent — environment. Copy to .env.local (dev) or .env (Docker).
# Never commit the real file. Full explanations: SETUP.md → "Environment reference".
# ─────────────────────────────────────────────────────────────────────────────

# ── Web access ──────────────────────────────────────────────────────────────
# Password-protects the web app + API (browser login prompt). Strongly recommended.
APP_PASSWORD=
APP_USER=                       # optional: also require this username

# ── AI providers (set one or both) ──────────────────────────────────────────
ANTHROPIC_API_KEY=              # https://platform.claude.com/settings/keys
OPENAI_API_KEY=                 # https://platform.openai.com/api-keys

# ── Routing ─────────────────────────────────────────────────────────────────
# auto = choose per request (fast / main / deep); anthropic|openai = prefer one provider.
LLM_MODE=auto
LLM_FALLBACK=true               # try the other provider when one fails
# Ordered candidates per tier: provider:model, provider:model
LLM_ROUTE_FAST=openai:gpt-5-mini,anthropic:claude-haiku-4-5-20251001
LLM_ROUTE_MAIN=anthropic:claude-sonnet-5-5,openai:gpt-5
LLM_ROUTE_DEEP=anthropic:claude-opus-5-5,openai:gpt-5
OPENAI_REASONING_EFFORT=low     # for gpt-5 / o-series: minimal|low|medium|high
OPENAI_TRANSCRIBE_MODEL=whisper-1   # WhatsApp voice notes
LLM_TIMEOUT_MS=60000
# ANTHROPIC_BASE_URL= / OPENAI_BASE_URL=   # only for proxies / gateways

# ── New projects: build a 3D/4D model from uploaded project documents ───────
# Uses ANTHROPIC_API_KEY / OPENAI_API_KEY above, and/or Gemini. Routed automatically by document type
# (PDFs/drawings: Claude → Gemini → OpenAI; huge text: Gemini first; otherwise Claude → OpenAI → Gemini; offline last).
# MODEL3D_ROUTE=anthropic,gemini,openai   # optional fixed order
GEMINI_API_KEY=                 # https://aistudio.google.com/apikey (optional)
GEMINI_MODEL=gemini-2.5-pro
MODEL3D_ANTHROPIC_MODEL=claude-sonnet-5-5
MODEL3D_OPENAI_MODEL=gpt-5
# GEMINI_BASE_URL=              # only for proxies / gateways

# ── WhatsApp (Meta WhatsApp Business Cloud API) ─────────────────────────────
WHATSAPP_TOKEN=                 # permanent System User token
WHATSAPP_PHONE_NUMBER_ID=       # from WhatsApp → API Setup
WHATSAPP_APP_SECRET=            # App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=          # any random string; paste the same into the webhook config
WHATSAPP_ALLOWED_NUMBERS=       # 9665XXXXXXXX:Name,9665YYYYYYYY:Name   (international format, no +)
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SHOW_MODEL=false       # append "provider · model · tier" under replies

# ── Purchasing system ───────────────────────────────────────────────────────
# demo | sap | oracle | rest   (webhook push works with any of them)
PROCUREMENT_PROVIDER=demo
PROCUREMENT_SYNC_MINUTES=15
PROCUREMENT_WEBHOOK_SECRET=     # Bearer secret for /api/integrations/procurement
# SAP S/4HANA (OData v2)
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_BEARER_TOKEN=
SAP_CLIENT=
SAP_PO_FILTER=                  # e.g. PurchasingGroup eq 'KH1'
SAP_PR_ENABLED=false
SAP_PR_DEFAULTS={"Plant":"KH01","MaterialGroup":"CONSTR","PurchasingGroup":"KH1"}
# Oracle Fusion Cloud Procurement (REST)
ORACLE_BASE_URL=
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_BEARER_TOKEN=
ORACLE_PO_QUERY=                # e.g. ProcurementBU='Kinan Heights'
# Generic REST (Odoo, Dynamics, Procore, middleware…)
PROCUREMENT_REST_URL=
PROCUREMENT_REST_TOKEN=
PROCUREMENT_REST_AUTH_HEADER=
PROCUREMENT_REST_MAP=
PROCUREMENT_REST_DELIVERIES_URL=
PROCUREMENT_REST_MR_URL=

# ── Data import & storage ───────────────────────────────────────────────────
IMPORT_SECRET=                  # Bearer secret for /api/import (schedule / drawing register CSV)
KINAN_DATA_DIR=                 # default ./data (db.json, uploads/, whatsapp sessions) — server/Docker
# Vercel: connect a Blob store (Storage tab) — Vercel adds BLOB_READ_WRITE_TOKEN for you.
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=kinan/              # folder inside the Blob store
CRON_SECRET=                    # Vercel Cron auth (sent as Bearer): /api/reports/run and /api/integrations/procurement?action=sync
AGENT_DEADLINE_MS=              # time budget per answer (default 50000 on Vercel, 110000 elsewhere)
NEXT_PUBLIC_BRAND_LOGO=         # optional: override the embedded logo (brand/kinan-logo.svg) with another image URL in public/

# ── Daily report (Daily report page; e-mailed through Outlook / Microsoft Graph) ──
# One e-mail a day with the status of every active project. Time, days, recipients and languages are set in the app.
REPORTS_CRON_KEY=               # enables /api/reports/run (x-api-key or Bearer); Vercel Cron calls it every minute (vercel.json)
REPORTS_ALLOWED_DOMAINS=        # recipients must be on these domains (comma-separated). Default: the domain of OUTLOOK_SENDER
REPORTS_ALLOWED_RECIPIENTS=     # or be named here one by one (comma-separated)
OUTLOOK_MODE=mock               # mock = nothing is e-mailed (shown as "simulated"); live = send through Microsoft Graph
OUTLOOK_SENDER=onsite@your-company.com   # the mailbox the report is sent from
MS_TENANT_ID=                   # Entra app registration with the Mail.Send application permission
MS_CLIENT_ID=
MS_CLIENT_SECRET=
