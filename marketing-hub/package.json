{
  "name": "bohio-marketing-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "db:push": "prisma db push",
    "demo:reset": "node -e \"require('fs').rmSync('prisma/dev.db',{force:true})\" && prisma db push --skip-generate",
    "demo:build": "tsx scripts/dump-data.ts && node scripts/build-demo.mjs",
    "demo:build:claude": "tsx scripts/dump-data.ts && node scripts/build-demo.mjs --claude-app",
    "chat:eval": "tsx scripts/chat-eval.ts",
    "postinstall": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "demo:package": "node scripts/package-demo.mjs",
    "demo:live": "node scripts/setup.mjs && next build && next start -p 3001"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.26.0",
    "@prisma/client": "^5.22.0",
    "html2canvas-pro": "^2.5.0",
    "jspdf": "^4.2.1",
    "next": "14.2.15",
    "openai": "^7.27.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
