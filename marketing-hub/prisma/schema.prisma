generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The property / project a campaign sells or leases.
model Asset {
  id        String     @id @default(cuid())
  name      String     @unique
  type      String
  location  String
  campaigns Campaign[]
}

model Vendor {
  id              String     @id @default(cuid())
  name            String     @unique
  category        String // Performance media | Property portal | Broker network | PR & brand | Outdoor | Influencer
  model           String // Retainer | Commission | Media buy
  retainerK       Float // monthly fixed fee, SAR K
  slaResponseHrs  Float // contractual max avg. lead response time
  slaQualifiedPct Float // contractual min qualified-lead rate
  contractEnd     DateTime
  contact         String
  oracleSupplierNumber String? // Supplier Number in Oracle Fusion Procurement
  email           String? // account-manager address used for outbound mail
  language        String  @default("en") // preferred language for emails: en | ar
  status          String  @default("ACTIVE") // ACTIVE | BENCH (pre-vetted alternative) | EXITED
  rateNote        String? // commercial terms / rate card summary (bench vendors)
  emails          OutboundEmail[]
  deliverables    Deliverable[]
  trialsAsChallenger Trial[] @relation("challenger")
  trialsAsIncumbent  Trial[] @relation("incumbent")
  experiments     Experiment[]
  campaigns       Campaign[]
  invoices        SupplierInvoice[]
  purchaseOrders  PurchaseOrder[]
}

model Campaign {
  id       String          @id @default(cuid())
  vendor   Vendor          @relation(fields: [vendorId], references: [id])
  vendorId String
  asset    Asset           @relation(fields: [assetId], references: [id])
  assetId  String
  name     String
  channel  String
  status   String // LIVE | PAUSED | ENDED
  budgetK  Float // total approved budget, SAR K
  startDate DateTime
  endDate   DateTime
  crmCode  String? // UTM campaign / CRM campaign code used to attribute leads
  months   CampaignMonth[]
  crmLeads CrmLead[]
  invoices SupplierInvoice[]
  purchaseOrders PurchaseOrder[]
}

// One row per campaign per month: spend -> funnel -> contracted sales.
model CampaignMonth {
  id           String   @id @default(cuid())
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  campaignId   String
  month        String // YYYY-MM
  spendK       Float
  impressionsK Float
  clicks       Int
  leads        Int
  qualified    Int
  viewings     Int
  reservations Int
  contracts    Int
  revenueM     Float // contracted sales value, SAR M
  respHrs      Float // avg. first-response time on leads

  @@unique([campaignId, month])
}

// Audit trail of orchestration decisions (pause / resume / budget shifts).
model MarketingAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String // PAUSE | RESUME | SHIFT_BUDGET
  campaign  String
  detail    String
}

// ---- Oracle integration: purchasing & supplier invoices ---------------------

model PurchaseOrder {
  id         String    @id @default(cuid())
  oraclePoId String    @unique
  poNumber   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  vendorId   String
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  campaignId String?
  amountK    Float // approved PO value, SAR K
  status     String // OPEN | CLOSED | ...
  description String?
  syncedAt   DateTime  @default(now())
}

model SupplierInvoice {
  id              String    @id @default(cuid())
  oracleInvoiceId String    @unique
  invoiceNumber   String
  vendor          Vendor    @relation(fields: [vendorId], references: [id])
  vendorId        String
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  campaignId      String?
  poNumber        String?
  period          String? // YYYY-MM the invoice bills for
  invoiceDate     DateTime
  dueDate         DateTime
  amountK         Float
  paidK           Float     @default(0)
  currency        String    @default("SAR")
  oracleStatus    String // Validated | Needs revalidation | Unvalidated | Cancelled
  description     String?
  // Decision taken here (Oracle is not written to)
  decision        String    @default("PENDING") // PENDING | APPROVED | DISPUTED
  decisionNote    String?
  decidedAt       DateTime?
  syncedAt        DateTime  @default(now())
}

model IntegrationSync {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  mode      String // mock | live
  invoices  Int
  purchaseOrders Int
  note      String?
}

// ---- Recommendations & outbound email (human-approved) ----------------------

// Recommendations are computed from live data; only their triage state is stored.
model RecommendationState {
  key       String   @id
  status    String // DISMISSED
  updatedAt DateTime @default(now())
}

model OutboundEmail {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  recKey       String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  vendorId     String
  toAddress    String
  ccAddresses  String    @default("") // comma-separated
  subject      String
  body         String
  drafter      String // template | claude
  revision     Int       @default(1) // bumped on every edit; approval must match
  status       String    @default("DRAFT") // DRAFT | SENT | REJECTED | FAILED
  approvedBy   String?
  approvedAt   DateTime?
  sentAt       DateTime?
  delivery     String? // mock | send | draft
  providerRef  String?
  error        String?
}

// ---- CRM integration (lead-level truth) ------------------------------------

model CrmLead {
  id              String    @id @default(cuid())
  crmId           String    @unique // id of the lead / opportunity in the CRM
  createdAt       DateTime
  source          String // campaign code as recorded in the CRM (utm_campaign / campaign)
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  campaignId      String? // null = could not be attributed to a vendor campaign
  stage           String // NEW | CONTACTED | QUALIFIED | VIEWING | RESERVED | WON | LOST
  firstResponseAt DateTime?
  owner           String?
  dealValueM      Float? // SAR M, when won / reserved
  closedAt        DateTime?
  lostReason      String?
  syncedAt        DateTime  @default(now())
}

model CrmSync {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  mode      String
  leads     Int
  matched   Int
  unmatched Int
}

// ---- Vendor operations, incrementality, re-bidding, data sources ----------

// Work items a vendor owes (creative, landing pages, reports…) → deadline adherence and revisions.
model Deliverable {
  id          String    @id @default(cuid())
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  vendorId    String
  title       String
  kind        String // CREATIVE | LANDING_PAGE | REPORT | LISTING | EVENT
  dueDate     DateTime
  deliveredAt DateTime?
  revisions   Int       @default(0)
}

// Paid trial of a bench vendor against an incumbent on the same brief.
model Trial {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  challenger    Vendor    @relation("challenger", fields: [challengerId], references: [id])
  challengerId  String
  incumbent     Vendor    @relation("incumbent", fields: [incumbentId], references: [id])
  incumbentId   String
  asset         String
  brief         String
  budgetK       Float
  weeks         Int
  crmCode       String // leads are attributed through the CRM with this code
  status        String // PROPOSED | APPROVED | RUNNING | COMPLETED | CANCELLED
  origin        String    @default("AGENT") // AGENT (auto re-bid) | USER
  approvedBy    String?
  startDate     DateTime?
  resultsJson   String? // { challenger: {spendK, leads, qualified, contracts}, incumbent: {...} }
  decision      String? // PROMOTE | EXTEND | KEEP_INCUMBENT
  decidedBy     String?
}

// Incrementality tests (audience holdout or geo test).
model Experiment {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  kind        String // HOLDOUT | GEO
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  vendorId    String
  campaign    String
  name        String
  status      String // PLANNED | RUNNING | COMPLETED
  designJson  String // holdout share / regions, weeks, metric, MDE
  dataJson    String? // results: holdout counts or weekly test/control series
  approvedBy  String?
}

// Weekly history for the media-mix model: spend per channel + total contracted sales.
model ChannelWeek {
  id       String @id @default(cuid())
  week     String // ISO date of the Monday
  channel  String // vendor category
  spendK   Float

  @@unique([week, channel])
}

model SalesWeek {
  id       String  @id @default(cuid())
  week     String  @unique
  salesM   Float
  ramadan  Boolean @default(false)
}

// Ad-platform data pulled from the ad accounts (independent of what vendors report).
model AdPlatformWeek {
  id           String @id @default(cuid())
  week         String
  platform     String // META | GOOGLE | SNAP | TIKTOK
  campaignCode String
  spendK       Float
  impressionsK Float
  clicks       Int
  platformLeads Int

  @@unique([week, platform, campaignCode])
}

// Log of syncs / imports for every source except CRM and Oracle (they have their own).
model SourceSync {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  source    String // ADS | VENDOR_REPORT
  mode      String
  rows      Int
  rejected  Int      @default(0)
  note      String?
}

// ---- AI Director of Marketing ------------------------------------------------

// Monthly sales targets per project — the director's north star.
model SalesTarget {
  id         String @id @default(cuid())
  asset      String
  month      String // YYYY-MM
  salesM     Float // contracted sales target, SAR M
  contracts  Int

  @@unique([asset, month])
}

// Next month's budget allocation across vendors, proposed by the director, approved by a person.
model BudgetPlan {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  month       String
  status      String // PROPOSED | APPROVED | REJECTED
  totalK      Float
  linesJson   String // [{ vendorId, vendor, currentK, proposedK, expectedIncrementalSalesM, rationale }]
  approvedBy  String?
  approvedAt  DateTime?
}

// Work the director delegates — to the team, to a vendor, or to Kinan's AI agent.
model DirectorTask {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  key        String    @unique // stable key so the same task is not created twice
  assignee   String // TEAM | VENDOR | KINAN_AGENT
  title      String
  detail     String
  payload    String? // JSON (e.g. lead ids for the Kinan agent)
  status     String    @default("PROPOSED") // PROPOSED | APPROVED | DONE | REJECTED
  approvedBy String?
  eventId    String? // Kinan event created on approval
}

// Outbox of everything fed to Kinan (Yardi + AI agent). Delivered with retries; audited.
model KinanEvent {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  type       String // lead.followup_requested | lead_source.quality | vendor.decision | budget.plan_approved | campaign.status_changed | brief.daily
  target     String // AGENT | YARDI
  payload    String // JSON
  status     String    @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts   Int       @default(0)
  lastError  String?
  deliveredAt DateTime?
  mode       String? // mock | webhook | yardi
  approvedBy String? // who released it (events that reach customers need a person)
}

// What Kinan's agent reports back (e.g. a follow-up outcome) — becomes CRM truth when it carries a lead id.
model KinanFeedback {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  payload   String
}
