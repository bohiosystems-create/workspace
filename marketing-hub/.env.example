# Copy to .env and fill in. Never commit the real .env.

# ---- AI providers (optional — everything works on built-in rules without them) ----
# Claude (Anthropic), OpenAI and Google Gemini; set any or all. Every AI job names a task and is routed to the best
# provider for it among those with a key, falling back down the list if one fails (see lib/llm.ts):
#   chat, analysis, draft, judge -> Claude, OpenAI, Gemini      ideate, summarize -> Gemini, OpenAI, Claude
# Campaign ideation runs on two different providers when two keys are set, then the judge ranks the ideas.
LLM_PROVIDER=auto
# Per-task order, e.g. LLM_ROUTE_IDEATE=anthropic,gemini (unlisted providers stay as fallbacks)
# LLM_ROUTE_CHAT=
# LLM_ROUTE_IDEATE=
# off = never fall back to another provider
LLM_FALLBACK=on
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher is more thorough but slower and costs more (fast tasks use low)
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Optional: Azure OpenAI or another OpenAI-compatible gateway
OPENAI_BASE_URL=
GEMINI_API_KEY=
# Deep tasks / fast tasks (check Google's current model list; names change often)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

DATABASE_URL="file:./dev.db"

# ---- Oracle Fusion Cloud (Procurement / Payables) ----
# mock = built-in sample data shaped like the Oracle REST payloads (default)
# live = call your Oracle instance (read-only GETs)
ORACLE_MODE=mock
ORACLE_BASE_URL=https://your-instance.fa.ocs.oraclecloud.com
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_API_VERSION=11.13.18.05
# Optional: restrict to one business unit name
ORACLE_BUSINESS_UNIT=

# ---- Outlook / Microsoft Graph (vendor emails, always human-approved) ----
# mock = nothing leaves the app; the send is simulated and clearly labelled
# live = Microsoft Graph with an Entra app registration (client credentials)
OUTLOOK_MODE=mock
# send  = Graph sendMail after a human approves in the app
# draft = create the message in the sender's Outlook Drafts; the human sends it from Outlook
OUTLOOK_DELIVERY=send
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the mail is sent from and vendor correspondence is read from (Mail.Send + Mail.Read application permissions;
# scope both to this mailbox with an Exchange ApplicationAccessPolicy)
OUTLOOK_SENDER=marketing@your-company.com
OUTLOOK_SENDER_NAME=Marketing Team
# Optional default cc (comma-separated)
OUTLOOK_CC=
# Set to off to skip AI polishing of drafts (built-in templates are always used as the base)
DRAFT_WITH_AI=on
CHAT_WITH_AI=on

# ---- CRM ----
# mock | ingest (CRM pushes to /api/crm/leads) | salesforce | dynamics (pull adapters not implemented yet)
CRM_MODE=mock
# Required to enable POST /api/crm/leads (send it as the x-api-key header)
CRM_INGEST_KEY=
OUTLOOK_SENDER_NAME_AR=فريق التسويق

# ---- Ad accounts & vendor report ingest ----
# mock | ingest (push to /api/ingest/ad-spend) | meta | google (pull adapters not implemented yet)
ADS_MODE=mock
# Enables POST /api/ingest/ad-spend and /api/ingest/vendor-report (send as x-api-key)
INGEST_API_KEY=

# ---- Kinan's sales agent: read-only ----
# The director only reads CRM results (Yardi) through CRM_MODE above; it sends nothing to the sales agent.

# Daily scheduled reports (lib/reports.ts). A scheduler calls POST /api/reports/run every 15 minutes with
# x-api-key: $REPORTS_CRON_KEY (or Authorization: Bearer). Time, days, recipients and language are set on /reports.
REPORTS_CRON_KEY=
# Recipients must be on these domains (comma-separated). Default: the domain of OUTLOOK_SENDER.
REPORTS_ALLOWED_DOMAINS=

# Meta (Facebook / Instagram) ads — lib/meta.ts. mock (default) | live | off.
# live: a system-user token with ads_read (+ business_management to read partner access) and the ad accounts to read.
META_MODE=mock
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_API_VERSION=v23.0

# --- Voice for the report player (▶ Play): ElevenLabs text-to-speech, server-side only ---
# Without a key the player uses the browser's own voice. Audio is cached per text, so replays cost nothing.
ELEVENLABS_API_KEY=
# Voice IDs from your ElevenLabs voice library (Arabic optional; the multilingual model speaks both)
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Live news for Kinan's focus cities (Google News RSS, no key). live (default) | snapshot | off
NEWS_MODE=live
NEWS_CITIES=Jeddah,Riyadh
# Your own calendar(s) as published ICS links (Outlook: Publish a calendar; Google: secret iCal address), comma-separated.
# Can also be pasted in Settings (gear icon). Celebrations (Umm al-Qura, national days, seasons) are built in.
CALENDAR_ICS_URL=
