{
  "//": "Register these MCP servers with your MCP client (Claude Desktop's claude_desktop_config.json, Claude Code's .mcp.json, or any MCP host). Use absolute paths to the .mjs files, or run from this mcp/ directory. Every connector shown in the platform's Settings tab maps to one of these servers.",
  "mcpServers": {
    "primavera-p6": {
      "command": "node",
      "args": ["primavera-mcp-server.mjs"],
      "env": {
        "P6_BASE_URL": "https://p6.example.com/p6ws",
        "P6_API_KEY": "${P6_API_KEY}"
      }
    },
    "synchro-4d": {
      "command": "node",
      "args": ["synchro-mcp-server.mjs"]
    },
    "autodesk-acc": {
      "command": "node",
      "args": ["autodesk-mcp-server.mjs"]
    },
    "sap-s4-epc": {
      "command": "node",
      "args": ["sap-mcp-server.mjs"]
    },
    "procore": {
      "command": "node",
      "args": ["procore-mcp-server.mjs"]
    },
    "trimble-works": {
      "command": "node",
      "args": ["trimble-mcp-server.mjs"]
    }
  }
}
