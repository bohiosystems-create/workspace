generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deal {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  assetName  String
  assetType  String?
  location   String?
  fund       String
  verdict    String // PASS | REVIEW | FAIL
  extracted  String // JSON string of the extracted figures
  underwrite String // JSON string of the computed underwrite + hurdle results
  memo       String // markdown IC memo
}

// ---- Reference data for LP Reporting and Debt & Covenants -----------------

model Fund {
  id             String         @id @default(cuid())
  name           String         @unique
  currency       String         @default("SAR")
  strategy       String?
  // Fund-level returns (from the cashflow models — not derivable from one period)
  netIrrPct      Float
  equityMultiple Float
  yieldOnCostPct Float
  dscr           Float
  assets         Asset[]
  distributions  Distribution[]
}

model Asset {
  id           String    @id @default(cuid())
  name         String
  type         String
  location     String
  fund         Fund      @relation(fields: [fundId], references: [id])
  fundId       String
  valuationM   Float
  noiM         Float
  occupancyPct Float?
  waleYears    Float?
  conceptStage Boolean   @default(false)
  facility     Facility?
  campaigns    Campaign[]
}

model Distribution {
  id      String @id @default(cuid())
  fund    Fund   @relation(fields: [fundId], references: [id])
  fundId  String
  period  String
  amountM Float

  @@unique([fundId, period])
}

model Facility {
  id             String   @id @default(cuid())
  asset          Asset    @relation(fields: [assetId], references: [id])
  assetId        String   @unique
  lender         String
  drawnM         Float
  ratePct        Float // all-in
  marginBps      Int
  ltvPct         Float
  dscr           Float
  icr            Float
  covenantDscr   Float
  covenantLtvPct Float
  maturity       DateTime
}


// ---- Marketing vendor orchestration ---------------------------------------

model Vendor {
  id              String     @id @default(cuid())
  name            String     @unique
  category        String // Performance media | Property portal | Broker network | PR & brand | Outdoor | Influencer
  model           String // Retainer | Commission | Media buy
  retainerK       Float // monthly fixed fee, SAR K
  slaResponseHrs  Float // contractual max avg. lead response time
  slaQualifiedPct Float // contractual min qualified-lead rate
  contractEnd     DateTime
  contact         String
  campaigns       Campaign[]
}

model Campaign {
  id       String          @id @default(cuid())
  vendor   Vendor          @relation(fields: [vendorId], references: [id])
  vendorId String
  asset    Asset           @relation(fields: [assetId], references: [id])
  assetId  String
  name     String
  channel  String
  status   String // LIVE | PAUSED | ENDED
  budgetK  Float // total approved budget, SAR K
  startDate DateTime
  endDate   DateTime
  months   CampaignMonth[]
}

// One row per campaign per month: spend -> funnel -> contracted sales.
model CampaignMonth {
  id           String   @id @default(cuid())
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  campaignId   String
  month        String // YYYY-MM
  spendK       Float
  impressionsK Float
  clicks       Int
  leads        Int
  qualified    Int
  viewings     Int
  reservations Int
  contracts    Int
  revenueM     Float // contracted sales value, SAR M
  respHrs      Float // avg. first-response time on leads

  @@unique([campaignId, month])
}

// Audit trail of orchestration decisions (pause / resume / budget shifts).
model MarketingAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String // PAUSE | RESUME | SHIFT_BUDGET
  campaign  String
  detail    String
}
