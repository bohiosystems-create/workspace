{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",

  "cleanUrls": false,
  "trailingSlash": false,

  "functions": {
    "api/whatsapp.js": { "maxDuration": 60 },
    "api/monday-webhook.js": { "maxDuration": 30 },
    "api/sync.js": { "maxDuration": 30 }
  },

  "rewrites": [
    { "source": "/schedule", "destination": "/schedule.html" },
    { "source": "/programme", "destination": "/schedule.html" }
  ],

  "headers": [
    {
      "source": "/reports/(.*).pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
