# Copy this file to `.env` and fill in your key to enable live Claude AI.
# The server loads .env automatically on startup. .env is gitignored.

# Your Anthropic API key (https://console.anthropic.com/ → API Keys).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-4-8
# PORT=5173

# Real sign-in (recommended on a public URL). Set both and the login form
# requires these exact credentials; the AI proxy then refuses calls from
# anyone who hasn't signed in — protecting your Anthropic credits.
# Leave DEMO_PASSWORD unset for the open demo gate (sign in as anyone).
# DEMO_USERNAME=matteo
# DEMO_PASSWORD=pick-a-strong-password
