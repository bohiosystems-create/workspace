# Copy this file to `.env` and fill in your key to enable live Claude AI.
# The server loads .env automatically on startup. .env is gitignored.

# Your Anthropic API key (https://console.anthropic.com/ → API Keys).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-4-8
# PORT=5173

# Real sign-in (recommended on a public URL). Set both and the login form
# requires these exact credentials; the AI proxy then refuses calls from
# anyone who hasn't signed in — protecting your Anthropic credits.
# Leave DEMO_PASSWORD unset for the open demo gate (sign in as anyone).
# DEMO_USERNAME=matteo
# DEMO_PASSWORD=pick-a-strong-password

# Real Outlook connector (one-time, free):
# 1. portal.azure.com → Entra ID → App registrations → New registration
#    ("Bohio Demo"; accounts in any org directory AND personal Microsoft
#    accounts; no redirect URI).
# 2. Copy the Application (client) ID here:
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# 3. In the app: Authentication → Allow public client flows → Yes;
#    API permissions → Microsoft Graph → Delegated → Mail.Read.
# Then press Connect on the Outlook connector in Settings — you'll sign in
# with a device code and the demo pulls your real mailbox.
# Optional alternatives (instead of the in-app sign-in):
# MS_TENANT=common
# MS_REFRESH_TOKEN=            # a Graph refresh token (offline_access)
# MS_GRAPH_TOKEN=              # a raw short-lived Graph access token
